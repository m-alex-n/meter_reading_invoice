<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_invoice_document_meter_reading" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th name="th_previous_reading" class="text-end">
                <span>Previous Reading</span>
            </th>
            <th name="th_new_reading" class="text-end">
                <span>New Reading</span>
            </th>
            <th name="th_actual_reading" class="text-end">
                <span>Actual Reading</span>
            </th>
        </xpath>

        <xpath expr="//td[@name='td_quantity']" position="before">
            <td name="td_previous_reading" class="text-end">
                <span t-field="line.previous_reading" class="text-nowrap">0.00</span>
            </td>
            <td name="td_new_reading" class="text-end">
                <span t-field="line.new_reading" class="text-nowrap">0.00</span>
            </td>
            <td name="td_actual_reading" class="text-end">
                <span t-field="line.actual_reading" class="text-nowrap">0.00</span>
            </td>
        </xpath>
    </template>

</odoo>
