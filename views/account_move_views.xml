<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_move_form_meter_reading" model="ir.ui.view">
        <field name="name">account.move.form.meter.reading</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="previous_reading" optional="show"/>
                <field name="new_reading" optional="show"/>
                <field name="actual_reading" optional="show" readonly="1"/>
            </xpath>

            <xpath expr="//page[@name='invoice_tab']//field[@name='invoice_line_ids']/form//field[@name='quantity']" position="before">
                <field name="previous_reading" readonly="1"/>
                <field name="new_reading"/>
                <field name="actual_reading" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
